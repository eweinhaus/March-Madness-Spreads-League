# Copy to .env.local and fill from Firebase Console → Project settings → Your apps (Web).

# Required on Vercel/production: full backend base URL (no trailing slash). Dev defaults to http://localhost:8000 if unset.
VITE_API_URL=http://localhost:8000

# Sport mode fallback (only used if backend /app-config fails): "football" or "march_madness"
VITE_SPORT_MODE=football

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
